<header class="inner-page-header inner-page-header-3">
    <div class="inner-header-shape"></div>
    <!-- header-content -->
    <div class="container">
        <div class="header-content m-auto">
            <h1>Membership Plan</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="index.html">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Membership Plan</li>
                </ol>
            </nav>
        </div>
    </div>
</header>
<!-- Pricing Section -->
<section class="pricing-section py-5">
    <div class="">
        @* <h2 class="text-center mb-5">Membership Plan</h2> *@
        <div class="row justify-content-center gx-0">
            
            <!-- Basic Plan -->
            <div class="col-md-4 d-flex justify-content-center">
                <div class="card shadow rounded-4 overflow-hidden card-custom">
                    <div class="card-header text-center py-4 bg-white">
                        <h5 class="text-muted mb-2">BASIC PLAN</h5>
                        <h3 class="fw-bold mb-1 text-success">₹99,999</h3>
                        <small>Valid for 3 Years</small>
                    </div>
                    <div class="card-body bg-gradient-basic">
                        <ul class="list-unstyled mb-4 text-start ps-4">
                            <li>✅ Every Year 6N 7D</li>
                            <li>✅ Only India</li>
                            <li>✅ Only Accommodation</li>
                            <li>✅ 4 Star hotels</li>    
                        </ul>
                        <div class="text-center">
                            <a href="#" class="btn subscribe-btn shadow p-3 mb-3 rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#subscribeModal">SUBSCRIBE</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Premium Plan -->
            <div class="col-md-4 d-flex justify-content-center">
                <div class="card shadow rounded-4 overflow-hidden card-custom">
                    <div class="card-header text-center py-4 bg-white">
                        <h5 class="text-muted mb-2">PREMIUM PLAN</h5>
                        <h3 class="fw-bold mb-1 text-primary">₹1,50,000</h3>
                        <small>Valid for 5 Years</small>
                    </div>
                    <div class="card-body bg-gradient-premium">
                        <ul class="list-unstyled mb-4 text-start ps-4">
                            <li>✅ India + Asian Countries</li>
                            <li>✅ Per Year 6N 7D</li>
                            <li>✅ Only Accommodation</li>
                            <li>✅ 4 Star properties</li>
                        </ul>
                        <div class="text-center">
                            <a href="#" class="btn subscribe-btn shadow p-3 mb-3 rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#subscribeModal">SUBSCRIBE</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Ultimate Plan -->
            <div class="col-md-4 d-flex justify-content-center">
                <div class="card shadow rounded-4 overflow-hidden card-custom">
                    <div class="card-header text-center py-4 bg-white">
                        <h5 class="text-muted mb-2">ULTIMATE PLAN</h5>
                        <h3 class="fw-bold mb-1 text-danger">₹3,50,000</h3>
                        <small>Valid for 10 Years</small>
                    </div>
                    <div class="card-body bg-gradient-ultimate">
                        <ul class="list-unstyled mb-4 text-start ps-4">
                            <li>✅ India + Asian Countries</li>
                            <li>✅ Per Year 6N 7D</li>
                            <li>✅ Only Accommodation</li>
                            <li>✅ 4 Star properties</li>
                        </ul>
                        <div class="text-center">
                            <a href="#" class="btn subscribe-btn shadow p-3 mb-3 rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#subscribeModal">SUBSCRIBE</a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Subscription Modal -->
<!-- Subscribe Modal -->
<div class="modal fade" id="subscribeModal" tabindex="-1" aria-labelledby="subscribeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content p-0 border-0 rounded-4 shadow-lg" style="overflow: hidden;">

            <!-- Header with Gradient -->
            <div class="modal-header text-center flex-column p-4"
                 style="background: linear-gradient(135deg, #fbc02d, #fdd835); color: #fff;">
                <h2 class="modal-title fw-bold fs-4" id="subscribeModalLabel">Subscribe Now</h2>
                <p class="fs-6 mb-0">Join our exclusive membership plans today!</p>
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Body -->
            <div class="modal-body p-4" style="background: #fff;">
                <form>
                    <!-- Name & Phone -->
                    <div class="row mb-3">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <div class="input-group shadow-sm rounded-pill overflow-hidden">
                                <span class="input-group-text bg-light border-0">
                                    <i class="bi bi-person-fill"></i>
                                </span>
                                <input type="text" class="form-control border-0" placeholder="Your Name" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="input-group shadow-sm rounded-pill overflow-hidden">
                                <span class="input-group-text bg-light border-0">
                                    <i class="bi bi-telephone-fill"></i>
                                </span>
                                <input type="text" class="form-control border-0" placeholder="Phone" required>
                            </div>
                        </div>
                    </div>

                    <!-- Email & Membership -->
                    <div class="row mb-3">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <div class="input-group shadow-sm rounded-pill overflow-hidden">
                                <span class="input-group-text bg-light border-0">
                                    <i class="bi bi-envelope-fill"></i>
                                </span>
                                <input type="email" class="form-control border-0" placeholder="Your Email" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <select class="form-select shadow-sm rounded-pill">
                                <option selected>Select Membership</option>
                                <option>Basic Plan - ₹99,999</option>
                                <option>Premium Plan - ₹1,50,000</option>
                                <option>Ultimate Plan - ₹3,50,000</option>
                            </select>
                        </div>
                    </div>

                    <!-- Adults & Kids -->
                    <div class="row mb-4">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <input type="number" class="form-control rounded-pill shadow-sm" placeholder="Number of Adults" required>
                        </div>
                        <div class="col-md-6">
                            <input type="number" class="form-control rounded-pill shadow-sm" placeholder="Number of Kids">
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <div class="text-center">
                        <button type="submit" class="btn btn-warning px-5 py-2 rounded-pill fw-bold shadow hover-glow">
                            Submit
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<!-- Include Bootstrap Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">


<style>
    /* Card Styling */
    .card-custom {
        width: 100%;
        max-width: 330px;
        background-color: #fff;
        margin-bottom: 20px;
        border-radius: 20px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card-custom:hover {
            transform: scale(1.06);
            box-shadow: 0 0 25px rgba(0, 0, 0, 0.2);
            z-index: 3;
        }

    .card-header h3 {
        font-size: 2rem;
    }

    ul li {
        font-size: 1rem;
        margin-bottom: 10px;
    }

    /* Gradient backgrounds */
    .bg-gradient-basic {
        background: linear-gradient(135deg, #00c9ff, #92fe9d);
        color: #fff;
    }

    .bg-gradient-premium {
        background: linear-gradient(135deg, #a770ef, #cf8bf3, #fdb99b);
        color: #fff;
    }

    .bg-gradient-ultimate {
        background: linear-gradient(135deg, #ff758c, #ff7eb3, #ffb199);
        color: #fff;
    }

    /* Subscribe button custom green hover */
    .subscribe-btn {
        background-color: white;
        color: black;
        border: none;
        transition: all 0.3s ease;
    }

        .subscribe-btn:hover {
            background-color: #28a745 !important; /* Bootstrap green */
            color: white;
            transform: scale(1.05);
        }

    .btn-warning:hover {
        background-color: #e0a800;
    }

    .pricing-section h2 {
        font-weight: 700;
    }

    .hover-glow:hover {
        box-shadow: 0 0 20px rgba(255, 193, 7, 0.6);
        transform: scale(1.05);
        transition: all 0.3s ease;
    }

    .form-control:focus, .form-select:focus {
        border-color: #fbc02d;
        box-shadow: 0 0 8px rgba(251, 192, 35, 0.5);
    }

    .input-group-text i {
        color: #fbc02d;
    }
</style>