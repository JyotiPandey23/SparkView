        const itemsPerPage = 10;
        let currentPage = 1;

        const destinationRow = document.getElementById('destinationRow');
        const pagination = document.getElementById('pagination');

        function renderCards(page) {
          destinationRow.innerHTML = '';
          const start = (page - 1) * itemsPerPage;
          const end = start + itemsPerPage;
          const pageItems = destinations.slice(start, end);

          pageItems.forEach(dest => {
            const card = document.createElement('div');
            card.className = 'col-sm-6 col-lg-4 col-xl-3 pb-30';
            card.innerHTML = `
              <div class="destination-card-full">
                <div class="destination-card-image">
                  <img src="${dest.img}" alt="${dest.name}">
                  <h3 class="destination-card-name">${dest.name}</h3>
                </div>
                <div class="card-1-content">
                  <div class="card-1-info">
                    <h3><a href="single-destination.html">${dest.name}</a></h3>
                    <div class="card-1-reviews">
                      <ul class="review-star">
                        <li class="full-star"><i></i></li>
                        <li class="full-star"><i></i></li>
                        <li class="full-star"><i></i></li>
                        <li class="full-star"><i></i></li>
                        <li class="full-star"><i></i></li>
                      </ul>
                      <span>(${dest.reviews} Reviews)</span>
                    </div>
                  </div>
                  <p>${dest.description}</p>
                </div>
                <div class="destination-card-link">
                  <a href="single-destination.html">&#8594;</a>
                </div>
              </div>
            `;
            destinationRow.appendChild(card);
          });
        }

        function renderPagination(page) {
          pagination.innerHTML = '';
          const totalPages = Math.ceil(destinations.length / itemsPerPage);

          // Previous button
          const prevLi = document.createElement('li');
          prevLi.className = 'page-item' + (page === 1 ? ' disabled' : '');
          prevLi.innerHTML = `<a class="page-link" href="#" aria-label="Previous">&#8249;</a>`;
          prevLi.addEventListener('click', e => {
            e.preventDefault();
            if (page > 1) {
              currentPage--;
              updatePage(currentPage);
            }
          });
          pagination.appendChild(prevLi);

          // Page numbers
          for (let i = 1; i <= totalPages; i++) {
            const li = document.createElement('li');
            li.className = 'page-item' + (i === page ? ' active' : '');
            li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
            li.addEventListener('click', e => {
              e.preventDefault();
              if (i !== currentPage) {
                currentPage = i;
                updatePage(currentPage);
              }
            });
            pagination.appendChild(li);
          }

          // Next button
          const nextLi = document.createElement('li');
          nextLi.className = 'page-item' + (page === totalPages ? ' disabled' : '');
          nextLi.innerHTML = `<a class="page-link" href="#" aria-label="Next">&#8250;</a>`;
          nextLi.addEventListener('click', e => {
            e.preventDefault();
            if (page < totalPages) {
              currentPage++;
              updatePage(currentPage);
            }
          });
          pagination.appendChild(nextLi);
        }

        function updatePage(page) {
          renderCards(page);
          renderPagination(page);
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Initial render
        updatePage(currentPage);
    </script>